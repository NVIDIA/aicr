                  "type": "string"
                },
                "nodeSelection": {
                  "type": "object",
                  "properties": {
                    "excludeNodes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "maxNodes": {
                      "type": "integer"
                    },
                    "selector": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      }
                    }
                  }
                },
                "timeout": {
                  "type": "string"
                }
