{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicr.run/schemas/v1/RecipeMetadata.schema.json",
  "title": "RecipeMetadata",
  "description": "An authored recipe overlay, as found in an external --data catalog.",
  "type": "object",
