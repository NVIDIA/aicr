                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "remediation": {
                        "type": "string"
                      },
                      "severity": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "infrastructure": {
                  "type": "string"
                },
                "nodeSelection": {
                  "type": "object",
                  "properties": {
                    "excludeNodes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "maxNodes": {
                      "type": "integer"
                    },
                    "selector": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      }
                    }
                  }
                },
                "timeout": {
                  "type": "string"
                }
              }
            },
            "performance": {
              "type": "object",
              "properties": {
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
