      },
      "spec": {
        "runtimeClassName": "nvidia",
        "nodeSelector": {
          "kubernetes.io/hostname": "gpu-worker-1"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "command": [
              "sh",
              "-c",
              "set -eu; nvidia-smi --query-gpu=uuid --format=csv,noheader > /tmp/gpus; cat /tmp/gpus; test \"$(grep -c \"^GPU-\" /tmp/gpus)\" -eq 1; echo ALLOCATED_GPU_ACCESS_PASS"
            ],
            "env": [
              {
                "name": "NVIDIA_VISIBLE_DEVICES",
