# UAT runner (nvkind / service: kind — DC5 #1278). Thin shim over
# tests/uat/lib/phases.sh, which holds the cloud-agnostic phase implementations
# and the phase dispatcher. Invoked phase-by-phase from
# .github/workflows/uat-kind.yaml so per-phase failures surface in the GitHub
# Actions UI.
#
# The cluster is a SINGLE-NODE, single-GPU nvkind cluster on a self-hosted GPU
# runner (provisioned by .github/actions/gpu-cluster-setup, not a cloud
# actuator). kind-specific behavior:
#   - TRAINJOB_NUM_NODES=1: one GPU, so the TrainJob runs on a single node (the
#     cloud lanes default to 2 to span their 2-GPU pool). The multi-node NCCL
#     East-West performance check skips gracefully on a single GPU node.
#   - Validator/agent image resolution to the runner-local ko.local registry is
#     set by uat-kind.yaml (AICR_IMAGE / AICR_VALIDATOR_IMAGE /
#     AICR_VALIDATOR_IMAGE_REGISTRY) for main cells; release cells self-resolve
#     released images. No credential-refresh hook is needed (the runner holds no
#     expiring cloud session), so cloud_refresh_credentials stays the default
#     no-op.
#
# Usage:
#   AICR_BIN=./aicr RUN_ID=12345 ./run <phase> <test-config.yaml>
# See tests/uat/lib/phases.sh for the phase list and the working files produced.

set -euo pipefail

# Single-GPU nvkind: run the TrainJob on one node. Set BEFORE sourcing so
# phases.sh's `TRAINJOB_NUM_NODES="${TRAINJOB_NUM_NODES:-2}"` cloud default
# defers to this; `:=` still honors an explicit env override for local repro.
: "${TRAINJOB_NUM_NODES:=1}"
export TRAINJOB_NUM_NODES

# shellcheck source=../lib/phases.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/phases.sh"

# Readiness census (issue #2096): disabled for the kind lane. This is a fixed
# SINGLE-NODE nvkind cluster with no cloud actuator and no CLUSTER_CONFIG, so
# there is no census-growth risk (no pool can scale up mid-validate), and the
# lone node may not carry the nodeGroup=gpu-worker label the census selector
# expects. The literal "skip" tells phases.sh to bypass the census check.
export EXPECTED_GPU_NODES=skip

uat_main "$@"
