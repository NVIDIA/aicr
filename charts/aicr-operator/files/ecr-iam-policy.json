{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthorizationToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "RuntimeRepositoryPushPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:${PARTITION}:ecr:${REGION}:${ACCOUNT_ID}:repository/${REPOSITORY_PREFIX}/*"
    }
  ]
}
