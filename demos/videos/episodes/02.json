  "scenes": [
    {
      "voice": [
        "A GPU cluster has many components.",
        "Some bring their own dependencies.",
        "Each has configuration files.",
        "Recipes pin versions for reproducibility.",
        "Some artifacts use digest pins.",
        "How do you know which recipes you can trust?"
      ]
    },
    {
      "voice": [
        "AICR helps answer two questions.",
        "Where did these components come from?",
        "Did they work together on real hardware?"
      ]
    },
    {
      "voice": [
        "The AICR release workflow signs build provenance for AICR,",
        "which ships with its recipes."
      ]
    },
    {
      "voice": [
        "Verify who built the deployment bundle,",
        "and trace that trust back to the AICR release.",
        "Change a single character in the bundle and verification fails."
      ]
    },
    {
      "voice": [
        "Contributors test recipes on real GPU clusters",
        "and publish signed results."
      ]
    },
    {
      "voice": [
        "Verify downloaded evidence offline,",
        "then run the checks on your own cluster."
      ]
    },
    {
      "voice": [
        "AICR.",
        "Recipes you can trust.",
        "Explore the project at aicr.run."
      ]
    }
  ],
