# Generated by AICR {{ .Version }} — do not edit.

output "criteria" {
  description = "The AICR criteria this bundle was resolved from."
  value       = {{ .Criteria | quote }}
}

# The three maps below are literals, known at plan time. depends_on on each
# output is what orders a caller that reads one after the install: without it
# a resource built from module.stack.components["x"] can be created while x
# is still installing, and fail on a namespace that does not exist yet.
output "components" {
  description = "Component -> namespace, for every component in the recipe."
  value = {
{{ align "    " .ComponentMap }}
  }

  depends_on = [
{{- range .Components }}
    module.{{ .Label }},
{{- end }}
  ]
}

output "releases" {
  description = "Helm release -> namespace, auxiliary pre/post/readiness releases included."
  value = {
{{ align "    " .ReleaseMap }}
  }

  depends_on = [
{{- range .Components }}
    module.{{ .Label }},
{{- end }}
  ]
}

output "namespaces" {
  description = "Distinct namespaces the bundle installs into."
  value       = distinct([{{ range $i, $r := .Components }}{{ if $i }}, {{ end }}{{ $r.Namespace | quote }}{{ end }}])

  depends_on = [
{{- range .Components }}
    module.{{ .Label }},
{{- end }}
  ]
}
