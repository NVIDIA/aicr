variable "wait" {
  description = <<-EOT
    Wait for each release's workloads to become ready before the resource is
    considered applied. This is what makes depends_on mean "the dependency is
    running", not merely "its manifests were submitted" — leave it on unless a
    component in this recipe is known to never converge (see README.md).
  EOT
  type        = bool
  default     = true
}

variable "timeout" {
  description = <<-EOT
    Per-release wait timeout, in seconds. Generous on purpose: several
    components in a datacenter recipe pull large images before any workload
    reports ready, and a short timeout turns a slow install into a confusing
    failure. A genuine hang is only delayed by this, not hidden.
  EOT
  type        = number
  default     = 900
}

variable "atomic" {
  description = "Roll a release back if it fails to install or upgrade. Implies wait: Helm waits whenever atomic is set, which is why the asynchronous components pin both to false. Off by default: a failed release left in place is easier to diagnose."
  type        = bool
  default     = false
}
