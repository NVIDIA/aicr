#
# One AICR component. localformat emits up to four folders for it — pre,
# primary, post, readiness — and they chain here in that order. A slot exists
# only when the bundle emitted that folder, so depends_on across a missing slot
# is a no-op rather than a hole in the chain.
#
# The recipe's edges sit on the module CALL in ../../main.tf, not on a resource
# in here: a depends_on on the call is a fact about everything the component
# expands into.

terraform {
  required_providers {
    helm = {
      source  = "hashicorp/helm"
      version = "~> 3.0"
    }
  }
}

# Pre-manifests: prerequisites the chart's own pods need, such as a Namespace
# carrying PSS labels.
resource "helm_release" "pre" {
  count = var.pre_chart == null ? 0 : 1

  name             = "${var.release_name}-pre"
  namespace        = var.namespace
  create_namespace = var.create_namespace

  chart       = var.pre_chart
  description = var.pre_chart_digest

  wait    = var.wait
  timeout = var.timeout
  atomic  = var.atomic
}

# The component's own chart.
resource "helm_release" "this" {
  name      = var.release_name
  namespace = var.namespace

  # The head slot owns the namespace. If pre ran it exists already, and Helm 3
  # refuses to adopt a namespace another release created out-of-band.
  create_namespace = var.pre_chart == null ? var.create_namespace : false

  # description carries a bundled chart's content digest, null for an upstream
  # chart. The provider updates it in place and re-reads the chart directory
  # on that upgrade, which is how a regenerated directory reaches the cluster.
  chart       = var.chart
  repository  = var.repository
  version     = var.chart_version
  description = var.chart_digest

  values = [for f in var.values_files : file(f)]

  # wait turns an ordering edge into a readiness edge. It does NOT wait on
  # custom-resource status: a component whose real signal is a CR condition
  # needs its readiness gate. See README.md. No wait_for_jobs, as deploy.sh
  # passes none: a bare Job in a chart is not what "ready" means here, and
  # the one Job that gates — the readiness hook — blocks on its own.
  wait    = var.wait
  timeout = var.timeout
  atomic  = var.atomic

  # Off by default, like the provider's own. Every call passes the bundle-wide
  # variable of the same name; see ../../variables.tf for when to set it.
  disable_openapi_validation = var.disable_openapi_validation

  depends_on = [helm_release.pre]
}

# Post-manifests: raw YAML instantiating CRDs the chart above installs, so it
# applies once those are registered.
resource "helm_release" "post" {
  count = var.post_chart == null ? 0 : 1

  name      = "${var.release_name}-post"
  namespace = var.namespace

  chart       = var.post_chart
  description = var.post_chart_digest

  wait    = var.wait
  timeout = var.timeout
  atomic  = var.atomic

  disable_openapi_validation = var.disable_openapi_validation

  depends_on = [helm_release.this]
}

# Readiness gate: a Job asserting the signal that actually means ready, such as
# a CR condition helm cannot see.
resource "helm_release" "readiness" {
  count = var.readiness_chart == null ? 0 : 1

  name      = "${var.release_name}-readiness"
  namespace = var.namespace

  # A regenerated gate whose files changed changes the digest, so the release
  # is upgraded and the hook runs again.
  chart       = var.readiness_chart
  description = var.readiness_chart_digest

  # Hardcoded, not var.wait: the waiting IS the gate. An async component may
  # skip waiting on its own workloads, never on the gate that asserts it came
  # up. No atomic — a rollback would delete the Job and its logs, which are
  # the diagnosis.
  #
  # No wait_for_jobs: the gate Job is a helm hook, and helm blocks on hook
  # completion as part of the release. wait_for_jobs covers Jobs in the
  # release's own resource set, which a hook is not, so it would do nothing
  # here. This matches deploy.sh, which passes --wait without --wait-for-jobs
  # for the same release for the same reason.
  #
  # The timeout is the gate's own deadline plus a buffer, not var.timeout:
  # the gate owns how long a deploy blocks on readiness, and helm must never
  # preempt it. Same derivation as deploy.sh's --timeout for this release.
  wait    = true
  timeout = 5700

  depends_on = [helm_release.this, helm_release.post]
}
