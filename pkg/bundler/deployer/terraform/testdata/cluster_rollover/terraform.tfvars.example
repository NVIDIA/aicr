# Generated by AICR v1.0.0. Copy to terraform.tfvars and edit, and carry
# that file to each regenerated bundle: an upgrade is a new directory.

# Point the bundle at an existing cluster.
# kubeconfig_path = "~/.kube/config"
# kube_context    = "kind-my-cluster"

# Required: what identifies that cluster. A change here replaces every
# release; a value that never changes keeps the shim inert, and for a cluster
# this configuration does not create its CA certificate is the natural one.
# A tfvars file holds literals only (no file()); pass a computed value with
# -var or TF_VAR_cluster_keepers.
# cluster_keepers = { ca = "<the cluster CA certificate, or any value minted per cluster>" }

# Per-release apply behaviour. atomic implies wait; the asynchronous
# components keep both off whatever is set here.
# wait    = true
# timeout = 900
# atomic  = false
#
# Skip the provider's OpenAPI validation of every release's manifests. See the
# variable's description before turning it on.
# disable_openapi_validation = false
