# Point the bundle at an existing cluster.
# kubeconfig_path = "~/.kube/config"
# kube_context    = "kind-my-cluster"

# Per-release apply behaviour. atomic implies wait; the asynchronous
# components keep both off whatever is set here.
# wait    = true
# timeout = 900
# atomic  = false
#
# Skip the provider's OpenAPI validation of every release's manifests. See the
# variable's description before turning it on.
# disable_openapi_validation = false
