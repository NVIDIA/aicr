#!/usr/bin/env python3
"""Check that published documentation links target published or repository files."""

from __future__ import annotations

import posixpath
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse

ROOT = Path(__file__).resolve().parent.parent
PUBLISHED_FILES = ROOT / "tools" / "docs-published-files"
GITHUB_REPO = "NVIDIA/aicr"


def published_paths() -> set[str]:
    result = subprocess.run([str(PUBLISHED_FILES)], check=True, capture_output=True, text=True)
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}


def markdown_links(path: Path) -> list[str]:
    text = path.read_text(encoding="utf-8")
    text = _without_fenced_code(text)
    links = _inline_links(text)
    references: dict[str, str] = {}
    for label, destination in _reference_definitions(text):
        references.setdefault(_normalize_reference_label(label), destination)
    links.extend(_reference_links(text, references))
    return links


def _reference_links(text: str, references: dict[str, str]) -> list[str]:
    links: list[str] = []
    index = 0
    while index < len(text):
        if text[index] != "[" or (index and text[index - 1] == "\\"):
            index += 1
            continue
        label_end = _label_end(text, index)
        if label_end < 0:
            index += 1
            continue
        text_label = text[index + 1 : label_end]
        cursor = label_end + 1
        if cursor < len(text) and text[cursor] == "[":
            reference_end = _label_end(text, cursor)
            if reference_end < 0:
                break
            reference_label = text[cursor + 1 : reference_end] or text_label
            if destination := references.get(_normalize_reference_label(reference_label)):
                links.append(destination)
            index = reference_end + 1
            continue

        if cursor < len(text) and text[cursor] in "(:":
            index = cursor + 1
            continue
        probe = cursor
        while probe < len(text) and text[probe] in " \t":
            probe += 1
        if probe < len(text) and text[probe] in "([:":
            index = cursor + 1
            continue
        if destination := references.get(_normalize_reference_label(text_label)):
            links.append(destination)
        index = label_end + 1
    return links


def _normalize_reference_label(label: str) -> str:
    return " ".join(label.casefold().split())


def _without_fenced_code(text: str) -> str:
    """Remove fenced blocks while respecting marker type and fence width."""
    kept: list[str] = []
    marker: str | None = None
    width = 0
    for line in text.splitlines(keepends=True):
        opener = re.match(r"^ {0,3}(`{3,}|~{3,})[^\n]*", line)
        if marker is None:
            if opener and (opener.group(1)[0] == "~" or "`" not in line[opener.end(1) :]):
                marker = opener.group(1)[0]
                width = len(opener.group(1))
                kept.append("\n" if line.endswith("\n") else "")
            else:
                kept.append(line)
            continue

        closing = re.match(rf"^ {{0,3}}{re.escape(marker)}{{{width},}}[ \t]*(?:\n|$)", line)
        if closing:
            marker = None
            width = 0
            kept.append("\n" if line.endswith("\n") else "")
        else:
            kept.append("\n" if line.endswith("\n") else "")
    return "".join(kept)


def _inline_links(text: str) -> list[str]:
    links: list[str] = []
    index = 0
    while index < len(text):
        if text[index] != "[" or (index and text[index - 1] == "\\"):
            index += 1
            continue
        label_end = _label_end(text, index)
        if label_end < 0:
            index += 1
            continue
        cursor = label_end + 1
        if cursor >= len(text) or text[cursor] != "(":
            index = label_end + 1
            continue
        destination = _parenthesized_destination(text, cursor + 1)
        if destination is not None:
            links.append(destination)
        index = cursor + 1
    return links


def _label_end(text: str, start: int) -> int:
    depth = 1
    cursor = start + 1
    while cursor < len(text):
        if text[cursor] == "\\":
            cursor += 2
            continue
        if text[cursor] == "[":
            depth += 1
        elif text[cursor] == "]":
            depth -= 1
            if depth == 0:
                return cursor
        cursor += 1
    return -1


def _parenthesized_destination(text: str, start: int) -> str | None:
    cursor = start
    while cursor < len(text) and text[cursor].isspace():
        cursor += 1
    if cursor < len(text) and text[cursor] == "<":
        end = text.find(">", cursor + 1)
        if end < 0:
            return None
        return text[cursor + 1 : end]

    begin = cursor
    depth = 0
    escaped = False
    while cursor < len(text):
        char = text[cursor]
        if escaped:
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == "(":
            depth += 1
        elif char == ")":
            if depth == 0:
                raw = text[begin:cursor].strip()
                return raw.split(None, 1)[0] if raw else None
            depth -= 1
        cursor += 1
    return None


def _reference_definitions(text: str) -> list[tuple[str, str]]:
    definitions: list[tuple[str, str]] = []
    for match in re.finditer(r"(?m)^ {0,3}\[", text):
        start = match.end() - 1
        label_end = _label_end(text, start)
        if label_end < 0 or label_end + 1 >= len(text) or text[label_end + 1] != ":":
            continue
        cursor = label_end + 2
        while cursor < len(text) and text[cursor] in " \t":
            cursor += 1
        if cursor < len(text) and text[cursor] in "\r\n":
            if text[cursor] == "\r":
                cursor += 1
                if cursor < len(text) and text[cursor] == "\n":
                    cursor += 1
            else:
                cursor += 1
            while cursor < len(text) and text[cursor] in " \t":
                cursor += 1
        if cursor >= len(text) or text[cursor] in "\r\n'\"":
            continue
        if text[cursor] == "<":
            end = text.find(">", cursor + 1)
            if end < 0 or "\n" in text[cursor + 1 : end]:
                continue
            destination = text[cursor + 1 : end]
        else:
            end = cursor
            while end < len(text) and not text[end].isspace():
                end += 1
            destination = text[cursor:end]
        if destination and _valid_reference_definition_tail(text, end):
            definitions.append((text[start + 1 : label_end], destination))
    return definitions


def _valid_reference_definition_tail(text: str, start: int) -> bool:
    """Return whether a definition tail is whitespace or a valid title."""
    line_end = text.find("\n", start)
    if line_end < 0:
        line_end = len(text)
    cursor = start
    while cursor < line_end and text[cursor] in " \t\r":
        cursor += 1
    if cursor == line_end:
        return True

    if text[cursor] in "'\"":
        quote = text[cursor]
        cursor += 1
        while cursor < line_end:
            if text[cursor] == "\\":
                cursor += 2
                continue
            if text[cursor] == quote:
                cursor += 1
                break
            cursor += 1
        else:
            return False
    elif text[cursor] == "(":
        cursor += 1
        while cursor < line_end:
            if text[cursor] == "\\":
                cursor += 2
                continue
            if text[cursor] == ")":
                cursor += 1
                break
            cursor += 1
        else:
            return False
    else:
        return False

    return not text[cursor:line_end].strip()


def relative_target(source: str, target: str) -> str | None:
    target = target.split("#", 1)[0].split("?", 1)[0]
    if not target or target.startswith(("/", "\\")):
        return None
    source_dir = posixpath.dirname(source)
    return posixpath.normpath(posixpath.join(source_dir, unquote(target)))


def github_blob_target(target: str) -> str | None:
    parsed = urlparse(target)
    if parsed.scheme != "https" or parsed.netloc != "github.com":
        return None
    parts = parsed.path.strip("/").split("/")
    if len(parts) < 5 or "/".join(parts[:2]) != GITHUB_REPO or parts[2:4] != ["blob", "main"]:
        return None
    decoded = unquote("/".join(parts[4:]))
    candidate = (ROOT / decoded).resolve()
    try:
        relative = candidate.relative_to(ROOT)
    except ValueError:
        return None
    return relative.as_posix()


def main() -> int:
    published = published_paths()
    errors: list[str] = []
    for source in sorted(published):
        source_path = ROOT / source
        for target in markdown_links(source_path):
            github_path = github_blob_target(target)
            if github_path is not None:
                if not (ROOT / github_path).exists():
                    errors.append(f"{source}: GitHub link target does not exist: {target}")
                continue

            parsed = urlparse(target)
            if parsed.scheme or parsed.netloc or target.startswith("#"):
                continue
            resolved = relative_target(source, target)
            if resolved and resolved.endswith(".md") and resolved not in published:
                errors.append(f"{source}: relative link targets unpublished page: {target}")

    if errors:
        print("Published documentation link check failed:", file=sys.stderr)
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"Published documentation links checked for {len(published)} pages.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
