#
# Refresh the pinned linux/amd64 SHA256 in .settings.yaml after an addlicense
# version bump. Invoked by Renovate via postUpgradeTasks
# (.github/renovate.json5) whenever linting.addlicense is updated.
#
# Without this the version moves and the pin does not, so the go-lint job's
# checksum verify fails closed on the next bump. addlicense is on the automerge
# list, which makes that worse than a red PR: the automerge never fires and the
# PR sits until someone computes a digest by hand.
#
# Usage: tools/update-addlicense-checksums <addlicense-version>
#   e.g. tools/update-addlicense-checksums v1.2.0
#
# Idempotent: re-running with the currently-pinned version produces no diff.

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <addlicense-version>" >&2
  exit 64
fi

VERSION="$1"
# addlicense is unusual among goreleaser projects in keeping the leading v in
# its asset names (addlicense_v1.2.0_Linux_x86_64.tar.gz), and the tag carries
# one too, so both spellings normalize to the v form here.
#
# Upstream has changed this once: v1.1.1 published addlicense_1.1.1_... with no
# v. Resolving only the v form is deliberate rather than an oversight -- this
# script must fetch exactly what setup-build-tools and tools/setup-tools will
# fetch, so if a future release reverts the naming, failing here with "no
# checksum entry matching ..." is the accurate signal that the install would
# 404 too. Do not make this tolerant of both spellings without changing the
# install sites to match, or a green refresh will hide a broken download.
VERSION_V="v${VERSION#v}"

SETTINGS_FILE=".settings.yaml"
if [[ ! -f "${SETTINGS_FILE}" ]]; then
  echo "ERROR: ${SETTINGS_FILE} not found (run from repo root)" >&2
  exit 1
fi

KEY="addlicense_sha256_linux_amd64"
TAR="addlicense_${VERSION_V}_Linux_x86_64.tar.gz"
CHECKSUMS_URL="https://github.com/google/addlicense/releases/download/${VERSION_V}/checksums.txt"

WORKDIR=$(mktemp -d)
trap 'rm -rf "${WORKDIR}"' EXIT

echo "Fetching ${CHECKSUMS_URL}"
# Retry on transient failures (5xx, 408/429, connection refused, network
# blips). --retry-delay 0 lets curl pick an exponential backoff; the total
# retry window is capped at 180s.
if ! curl --fail --silent --show-error --location \
      --connect-timeout 10 --max-time 60 \
      --retry 5 --retry-delay 0 --retry-max-time 180 \
      --retry-connrefused \
      --output "${WORKDIR}/checksums.txt" \
      "${CHECKSUMS_URL}"; then
  echo "ERROR: failed to download ${CHECKSUMS_URL} after retries" >&2
  exit 1
fi

# Each line is "<sha256>  addlicense_<ver>_<os>_<arch>.tar.gz". Anchor on
# end-of-line so a sibling entry for the same platform cannot match.
LINE=$(grep -E "  ${TAR//./\\.}\$" "${WORKDIR}/checksums.txt" || true)
if [[ -z "${LINE}" ]]; then
  echo "ERROR: no checksum entry matching ${TAR} in ${CHECKSUMS_URL}" >&2
  exit 1
fi
SHA="${LINE%% *}"
if [[ ! "${SHA}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "ERROR: extracted value is not a sha256: '${SHA}'" >&2
  exit 1
fi
echo "  ${KEY}: ${SHA}"

# Targeted sed rather than yq: mikefarah/yq drops blank lines between top-level
# mappings, which would reformat the whole file on every Renovate PR (see the
# failure-modes note in .github/RENOVATE.md).
sed_inplace() {
  if sed --version >/dev/null 2>&1; then
    sed -E -i "$@"          # GNU sed (Linux / Renovate runner)
  else
    sed -E -i '' "$@"       # BSD sed (macOS)
  fi
}

# Pre-check: the key must exist in the expected shape, otherwise the sed below
# silently no-ops and we ship a stale checksum.
if ! grep -Eq "^[[:space:]]+${KEY}:[[:space:]]*'[0-9a-f]{64}'[[:space:]]*\$" "${SETTINGS_FILE}"; then
  echo "ERROR: key '${KEY}' not found (or wrong shape) in ${SETTINGS_FILE}" >&2
  exit 1
fi

# Guard the uniqueness the no-scoping decision rests on.
OCCURRENCES=$(grep -Ec "^[[:space:]]+${KEY}:" "${SETTINGS_FILE}")
if [[ "${OCCURRENCES}" -ne 1 ]]; then
  echo "ERROR: expected exactly 1 '${KEY}' line, found ${OCCURRENCES}" >&2
  exit 1
fi

sed_inplace \
  -e "s|^([[:space:]]+${KEY}:[[:space:]]*)'[0-9a-f]{64}'\$|\1'${SHA}'|" \
  "${SETTINGS_FILE}"

# Post-check: confirm the new value landed on that key.
if ! grep -Eq "^[[:space:]]+${KEY}:[[:space:]]*'${SHA}'[[:space:]]*\$" "${SETTINGS_FILE}"; then
  echo "ERROR: ${KEY} did not update to '${SHA}' in ${SETTINGS_FILE}" >&2
  exit 1
fi

echo "Updated ${SETTINGS_FILE} for addlicense ${VERSION_V}"
