set -euo pipefail

phases="${VALIDATOR_PHASES:-deployment performance conformance}"
arches="${VALIDATOR_ARCHES:-$(go env GOARCH)}"

# Accept comma-separated workflow inputs as well as shell-friendly lists.
phases="${phases//,/ }"
arches="${arches//,/ }"
read -r -a phase_list <<< "${phases}"
read -r -a arch_list <<< "${arches}"

for arch in "${arch_list[@]}"; do
  case "${arch}" in
    amd64|arm64) ;;
    *)
      echo "unsupported validator architecture: ${arch}" >&2
      exit 1
      ;;
  esac

  mkdir -p "dist/validator/${arch}"
  for phase in "${phase_list[@]}"; do
    if ! [[ "${phase}" =~ ^[a-z][a-z0-9_-]*$ ]] || [[ ! -d "validators/${phase}" ]]; then
      echo "invalid validator phase: ${phase}" >&2
      exit 1
    fi
    echo "Building validator binary: ${phase} (linux/${arch})"
    CGO_ENABLED=0 GOOS=linux GOARCH="${arch}" GOFLAGS="-mod=readonly" \
      go build -trimpath -o "dist/validator/${arch}/${phase}" "./validators/${phase}"
  done
done
