# Runs the walking skeleton on the operator's kind cluster: installs the
# pinned Argo CD chart, builds the operator image with ko and loads it into
# kind, installs charts/aicr-operator with
# tests/operator/skeleton/testdata/values.yaml, then runs the skeleton tests.
# Create the cluster first with `make operator-kind-up`.
#
# Usage: tools/operator-skeleton [install|test]   (default: both)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

cluster="${OPERATOR_KIND_CLUSTER:-aicr-operator}"
export KUBECONFIG="${repo_root}/.operator-e2e/kubeconfig"
# shellcheck source=tools/operator-lib.sh
source tools/operator-lib.sh

export AICR_VERSION="${AICR_E2E_VERSION:-$(setting '.operator.aicr_version')}"
export AICR_IMAGE="${AICR_E2E_IMAGE:-$(setting '.operator.aicr_image')}"
VALIDATOR_IMAGES="${AICR_E2E_VALIDATOR_IMAGES:-$(setting '.operator.aicr_validator_images | [.[]] | join(",")')}"
REGISTRY_URI="$(yq -r '.registry.repository' tests/operator/skeleton/testdata/values.yaml)"
OPERATOR_IMAGE="$(yq -r '.operator.image' tests/operator/skeleton/testdata/values.yaml)"

install() {
  local arch docker_host empty
  install_argocd

  # Build for the node's architecture. An empty docker config keeps stale
  # local registry credentials away from the anonymous base-image pull.
  arch="$(kubectl get nodes -o jsonpath='{.items[0].status.nodeInfo.architecture}')"
  docker_host="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true)"
  empty="$(mktemp -d "${work}/docker.XXXXXX")"
  echo '{}' > "${empty}/config.json"
  DOCKER_HOST="${DOCKER_HOST:-${docker_host}}" DOCKER_CONFIG="${empty}" KO_DOCKER_REPO=ko.local/aicr-operator \
    go run "github.com/google/ko@$(setting '.build_tools.ko')" build --bare --sbom=none --push=false --platform="linux/${arch}" --tags=skeleton ./cmd/aicr-operator
  kind load docker-image "${OPERATOR_IMAGE}" --name "${cluster}"

  operator_namespace
  release_flags "${AICR_VERSION}"
  helm upgrade --install aicr-operator charts/aicr-operator --namespace aicr-system \
    -f tests/operator/skeleton/testdata/values.yaml \
    --set aicr.version="${AICR_VERSION}" --set aicr.image="${AICR_IMAGE}" \
    --set "aicr.validatorImages={${VALIDATOR_IMAGES}}" \
    "${HELM_RELEASE_FLAGS[@]}" >/dev/null
  registry_credentials "${REGISTRY_URI}"
  kubectl -n aicr-system rollout restart deployment/aicr-operator
  kubectl -n aicr-system rollout status deployment/aicr-operator --timeout=180s
}

run_tests() {
  AICR_OPERATOR_E2E_KUBECONFIG="${KUBECONFIG}" AICR_OPERATOR_E2E_AICR_VERSION="${AICR_VERSION}" AICR_E2E_IMAGE="${AICR_IMAGE}" \
    AICR_OPERATOR_E2E_REGISTRY_AUTH="${repo_root}/.operator-e2e/registry-auth.json" \
    GOFLAGS="-mod=readonly" go test -count=1 -v -timeout=70m ./tests/operator/skeleton/...
}

case "${1:-all}" in
install) install ;;
test) run_tests ;;
# Sequential, not `install && run_tests`: errexit does not apply inside a
# function that is part of an && list.
all)
  install
  run_tests
  ;;
*)
  echo "usage: $0 [install|test]" >&2
  exit 2
  ;;
esac
