# Runs the fault-injection and isolation qualification suite against a
# candidate (`make operator-candidate`) on the operator's kind cluster. It installs the
# pinned Argo CD chart, loads the candidate's operator and registry images
# into the nodes by digest, installs the candidate's chart with its deployment inputs and
# tests/operator/qualify/testdata/values.yaml, then runs
# tests/operator/qualify. The candidate is a release build: no development
# setting is available, so the suite discovers the kind nodes and approves
# rollouts as an approver. Create the cluster first with
# `make operator-kind-up`.
#
# Usage: tools/operator-qualify [install|reinstall|upgrade|rollback|pull-published|test]   (default: install, then test)
#   install    Argo CD and the candidate in CANDIDATE_DIR (default dist/candidate)
#   reinstall  the candidate in CANDIDATE_DIR again with the same values, as an
#              administrator restores the chart's objects
#   upgrade    the candidate in CANDIDATE_NEXT_DIR (default dist/candidate-next),
#              as an operator upgrade; the suite runs it mid-rollout
#   rollback   helm rollback to the newest revision that installed the
#              candidate in CANDIDATE_DIR, as an operator downgrade
#   pull-published
#              the newest published release, attestations verified, into
#              PUBLISHED_DIR as a candidate (make operator-qualify-published);
#              PUBLISHED_VERSION pins a release, PUBLISHED_BELOW bounds it
#   test       the suite
#
# AICR_OPERATOR_QUALIFY_LIFECYCLE_ONLY=1 runs only the lifecycle scenarios and
# QUALIFY_TIMEOUT bounds the suite (default 90m).
# QUALIFY_VALIDATION=1 installs or upgrades with validation.enabled; the
# suite's deployment validation scenario sets it for its own upgrade.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

export OPERATOR_KIND_CLUSTER="${OPERATOR_KIND_CLUSTER:-aicr-operator}"
export KUBECONFIG="${repo_root}/.operator-e2e/kubeconfig"
# shellcheck source=tools/operator-lib.sh
source tools/operator-lib.sh

candidate="${CANDIDATE_DIR:-dist/candidate}"
next="${CANDIDATE_NEXT_DIR:-dist/candidate-next}"
values=tests/operator/qualify/testdata/values.yaml

# load_candidate imports the candidate's operator and registry image indexes
# into every node and names them by digest, as a registry pull would; the
# kubelet then runs the exact images the candidate records, never a rebuild.
load_candidate() {
  load_image "$1" image operator
  load_image "$1" registry-image registry
}

# load_image imports the image index in the layout $2 of candidate $1, which
# candidate.json records under key $3.
load_image() {
  local dir="$1" layout="$2" key="$3" repository digest version tmp node
  repository="$(yq -r ".${key}.repository" "${dir}/candidate.json")"
  digest="$(yq -r ".${key}.digest" "${dir}/candidate.json")"
  version="$(yq -r '.version' "${dir}/candidate.json")"
  tmp="$(mktemp -d "${work}/candidate.XXXXXX")"
  cp -R "${dir}/${layout}" "${tmp}/layout"
  yq -i -o=json ".manifests[0].annotations.\"org.opencontainers.image.ref.name\" = \"${repository}:${version}\"" "${tmp}/layout/index.json"
  tar -C "${tmp}/layout" -cf "${tmp}/image.tar" .
  # Each node imports its own platform only (kind's loader unpacks every
  # platform), then names the index by its digest.
  while read -r node; do
    docker exec -i "${node}" ctr -n k8s.io images import --digests --snapshotter=overlayfs - <"${tmp}/image.tar" >/dev/null
    docker exec "${node}" ctr -n k8s.io images tag --force "${repository}:${version}" "${repository}@${digest}" >/dev/null
  done < <(kind get nodes --name "${OPERATOR_KIND_CLUSTER}")
}

# install_candidate installs or upgrades the operator release to a
# candidate's chart and image, with the AICR release under test.
install_candidate() {
  local dir="$1" aicr_version
  load_candidate "${dir}"
  operator_namespace
  aicr_version="${AICR_E2E_VERSION:-$(yq -r '.aicr.version' "${dir}/candidate-values.yaml")}"
  release_flags "${aicr_version}"
  helm upgrade --install aicr-operator "${dir}"/chart/*.tgz --namespace aicr-system \
    -f "${dir}/candidate-values.yaml" -f "${values}" \
    --set aicr.version="${aicr_version}" \
    --set aicr.image="${AICR_E2E_IMAGE:-$(yq -r '.aicr.image' "${dir}/candidate-values.yaml")}" \
    --set "aicr.validatorImages={${AICR_E2E_VALIDATOR_IMAGES:-$(yq -r '.aicr.validatorImages | join(",")' "${dir}/candidate-values.yaml")}}" \
    ${QUALIFY_VALIDATION:+--set validation.enabled=true} \
    "${HELM_RELEASE_FLAGS[@]}" >/dev/null
  kubectl -n aicr-system rollout status deployment/aicr-registry --timeout=180s
  kubectl -n aicr-system rollout status deployment/aicr-operator --timeout=180s
}

# rollback_to_candidate rolls the operator release back with helm rollback to
# the newest revision that installed candidate $1: a downgrade, as
# docs/operator/lifecycle.md describes it, not a reinstall.
rollback_to_candidate() {
  local dir="$1" version revision aicr_version
  version="$(yq -r '.version' "${dir}/candidate.json")"
  revision="$(helm history aicr-operator --namespace aicr-system --output json |
    jq -r --arg v "${version}" '[.[] | select(.app_version == $v)] | last | .revision // empty')"
  if [[ -z "${revision}" ]]; then
    echo "no revision of aicr-operator installed ${version}" >&2
    return 1
  fi
  aicr_version="${AICR_E2E_VERSION:-$(yq -r '.aicr.version' "${dir}/candidate-values.yaml")}"
  release_flags "${aicr_version}"
  helm rollback aicr-operator "${revision}" --namespace aicr-system "${HELM_RELEASE_FLAGS[@]}" >/dev/null
  kubectl -n aicr-system rollout status deployment/aicr-registry --timeout=180s
  kubectl -n aicr-system rollout status deployment/aicr-operator --timeout=180s
}

# pull_published writes the newest published release into PUBLISHED_DIR
# (default dist/published) in a candidate's layout, then verifies that
# NVIDIA/aicr's release workflow attested its chart and images at that
# release's tag. Without PUBLISHED_VERSION, which pins a release, it picks
# among versions with a published, non-prerelease GitHub release, so a release
# still in progress is never chosen; PUBLISHED_BELOW, set to the release being
# built, keeps the choice older than it. Only the default directory is
# replaced; any other must be empty or absent, which operator-release pull
# checks.
pull_published() {
  local dir="${PUBLISHED_DIR:-dist/published}" out version chart_repo chart_digest image_ref registry_ref ref released
  local args=(pull -version "${PUBLISHED_VERSION:-latest}" -dir "${dir}")
  if [[ -z "${PUBLISHED_VERSION:-}" ]]; then
    released="$(gh release list --repo NVIDIA/aicr --exclude-drafts --exclude-pre-releases --limit 100 \
      --json tagName --jq '[.[].tagName] | join(",")')"
    args+=(-released "${released}")
  fi
  if [[ -n "${PUBLISHED_BELOW:-}" ]]; then
    args+=(-below "${PUBLISHED_BELOW}")
  fi
  if [[ "${dir}" == dist/published ]]; then
    rm -rf -- dist/published
  fi
  out="$(go run ./tools/operator-release "${args[@]}")"
  echo "${out}"
  version="$(sed -n 's/^version=//p' <<<"${out}")"
  chart_repo="$(sed -n 's/^chart-repository=//p' <<<"${out}")"
  chart_digest="$(sed -n 's/^chart-digest=//p' <<<"${out}")"
  image_ref="$(sed -n 's/^image-ref=//p' <<<"${out}")"
  registry_ref="$(sed -n 's/^registry-ref=//p' <<<"${out}")"
  for ref in "oci://${chart_repo}@${chart_digest}" "oci://${image_ref}" "oci://${registry_ref}"; do
    verify_release_attestation "${ref}" "${version}"
    echo "verified ${ref}"
  done
}

# verify_release_attestation requires an attestation of ref by NVIDIA/aicr's
# operator release workflow at tag v$2: attest-operator.yaml, or on-tag.yaml,
# which signed v1.2.0 and its release candidates.
verify_release_attestation() {
  local ref="$1" version="$2" workflow
  for workflow in attest-operator.yaml on-tag.yaml; do
    if gh attestation verify "${ref}" --repo NVIDIA/aicr \
      --signer-workflow "NVIDIA/aicr/.github/workflows/${workflow}" \
      --source-ref "refs/tags/v${version}" >/dev/null 2>&1; then
      return 0
    fi
  done
  echo "no release attestation for ${ref} at v${version}" >&2
  return 1
}

# absolute resolves a candidate directory, which may be relative to the
# repository root, for the suite.
absolute() {
  if [[ "$1" == /* ]]; then echo "$1"; else echo "${repo_root}/$1"; fi
}

run_tests() {
  AICR_OPERATOR_E2E_KUBECONFIG="${KUBECONFIG}" \
    AICR_OPERATOR_E2E_AICR_VERSION="${AICR_E2E_VERSION:-$(yq -r '.aicr.version' "${candidate}/candidate-values.yaml")}" \
    AICR_OPERATOR_QUALIFY_CANDIDATE="$(absolute "${candidate}")/candidate.json" \
    AICR_OPERATOR_QUALIFY_NEXT="$(absolute "${next}")/candidate.json" \
    GOFLAGS="-mod=readonly" go test -count=1 -v -timeout="${QUALIFY_TIMEOUT:-90m}" ./tests/operator/qualify/...
}

case "${1:-all}" in
install)
  install_argocd
  install_candidate "${candidate}"
  ;;
reinstall) install_candidate "${candidate}" ;;
upgrade) install_candidate "${next}" ;;
rollback) rollback_to_candidate "${candidate}" ;;
pull-published) pull_published ;;
test) run_tests ;;
# Sequential, not `install && run_tests`: errexit does not apply inside a
# function that is part of an && list.
all)
  install_argocd
  install_candidate "${candidate}"
  run_tests
  ;;
*)
  echo "usage: $0 [install|reinstall|upgrade|rollback|pull-published|test]" >&2
  exit 2
  ;;
esac
