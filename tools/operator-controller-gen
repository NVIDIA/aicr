# Runs controller-gen at the version pinned in .settings.yaml
# (operator.controller_gen) without adding it to go.mod, then generates the
# API deep copies and CRDs. Invoked by `go generate` from api/operator/v1alpha1.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
version="$(yq -r '.operator.controller_gen' "${repo_root}/.settings.yaml")"
if [[ -z "${version}" || "${version}" == "null" ]]; then
  echo "operator.controller_gen is not set in .settings.yaml" >&2
  exit 1
fi

cd "${repo_root}"
gen=(go run "sigs.k8s.io/controller-tools/cmd/controller-gen@${version}")
"${gen[@]}" object:headerFile=tools/operator-boilerplate.go.txt paths=./api/...
"${gen[@]}" crd paths=./api/... output:crd:dir=charts/aicr-operator/files/crds

# controller-gen writes no license header; prepend the repository's header so
# generated CRDs pass the license check without a separate tool.
for crd in charts/aicr-operator/files/crds/*.yaml; do
  tmp="$(mktemp)"
  sed -e 's/^/# /' -e 's/ *$//' .github/headers/LICENSE > "${tmp}"
  echo >> "${tmp}"
  cat "${crd}" >> "${tmp}"
  mv "${tmp}" "${crd}"
done
