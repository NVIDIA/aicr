# Vendor the CNCF AI Conformance submission validator
# (cncf/k8s-ai-conformance scripts/validate.go) at the revision pinned in
# pkg/evidence/cncf/upstreamvalidator/provenance.go, so `aicr validate
# --cncf-submission` can run it in process as the last step of a submission
# run. Upstream ships it as a `go run -tags validate` script, not a module or
# a release binary, so the file is copied and compiled into the binary.
#
# The copy is the upstream source with a fixed list of mechanical edits, each
# applied by a sed expression below and each one required to call the script
# from Go instead of from the command line:
#
#   * the `validate` build tag goes, so the file compiles into the binary;
#   * `package main` becomes `package upstreamvalidator`;
#   * `main()` becomes `run(args []string) int`, reading its arguments from the
#     parameter instead of os.Args and returning the exit status instead of
#     calling os.Exit, so the caller decides what a failure means;
#   * every fmt.Print* writes to the package variable `stdout` instead of the
#     process stdout, so the report is captured and never interleaves with the
#     CTRF JSON `aicr validate` writes there;
#   * the schema directory `docs` becomes the package variable `schemaDir`, so
#     the caller points it at the embedded checklist copy instead of the
#     process working directory.
#
# Nothing else changes: the validation rules, the URL and landscape checks and
# their timeouts, and every message are upstream's. The script fails when the
# fetched source does not have the pinned digest, and the generated file
# carries a "Code generated" header so the repository's linters leave
# upstream's style alone. TestVendoredValidatorMatchesPin pins the generated
# file's digest, so a refresh is a deliberate edit of the pin and the file
# together: bump upstreamCommit and upstreamDigest in provenance.go, run this
# script, review the diff against the assumptions listed in
# docs/conformance/cncf/index.md, then update vendoredDigest.
#
# Usage: tools/vendor-cncf-validator
# Needs network access to raw.githubusercontent.com.

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/common
. "${DIR}/common"

has_tools curl sed shasum awk gofmt

readonly PACKAGE_DIR="${REPO_ROOT}/pkg/evidence/cncf/upstreamvalidator"
readonly PROVENANCE="${PACKAGE_DIR}/provenance.go"
readonly TARGET="${PACKAGE_DIR}/validate.go"
readonly UPSTREAM_PATH="scripts/validate.go"

pin() {
    local name="$1"
    local value
    value="$(sed -n "s/^[[:space:]]*${name}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${PROVENANCE}" | head -1)"
    [[ -n "${value}" ]] || err "${name} not found in ${PROVENANCE}"
    printf '%s' "${value}"
}

COMMIT="$(pin upstreamCommit)"
WANT_DIGEST="$(pin upstreamDigest)"
readonly COMMIT WANT_DIGEST
readonly URL="https://raw.githubusercontent.com/cncf/k8s-ai-conformance/${COMMIT}/${UPSTREAM_PATH}"

tmp="$(mktemp "${TMPDIR:-/tmp}/vendor-cncf-validator.XXXXXX")"
trap 'rm -f "${tmp}"' EXIT

log_info "Fetching ${URL}"
curl --fail --silent --show-error --location --output "${tmp}" "${URL}"

got_digest="$(shasum -a 256 "${tmp}" | cut -d' ' -f1)"
if [[ "${got_digest}" != "${WANT_DIGEST}" ]]; then
    err "upstream ${UPSTREAM_PATH} at ${COMMIT} has digest ${got_digest}, pinned ${WANT_DIGEST}; refusing to vendor"
fi

{
    cat <<EOF
// Code generated by tools/vendor-cncf-validator from
// github.com/cncf/k8s-ai-conformance ${UPSTREAM_PATH} at commit
// ${COMMIT}; DO NOT EDIT.
//
// Copyright The Linux Foundation and the CNCF AI Conformance contributors.
// Licensed under the Apache License, Version 2.0; see
// https://github.com/cncf/k8s-ai-conformance/blob/${COMMIT}/LICENSE.
//
// Upstream sha256 ${WANT_DIGEST}.
// The edits applied to the upstream source are listed in
// tools/vendor-cncf-validator; everything else is verbatim.

EOF
    sed \
        -e '/^\/\/go:build validate$/,/^$/d' \
        -e 's/^package main$/package upstreamvalidator/' \
        -e 's/^func main() {$/func run(args []string) int {/' \
        -e 's/if len(os\.Args) < 2 {/if len(args) < 1 {/' \
        -e 's/for _, path := range os\.Args\[1:\] {/for _, path := range args {/' \
        -e 's/^\([[:space:]]*\)os\.Exit(1)$/\1return 1/' \
        -e 's/fmt\.Println(/fmt.Fprintln(stdout, /g' \
        -e 's/fmt\.Printf(/fmt.Fprintf(stdout, /g' \
        -e 's/filepath\.Join("docs", /filepath.Join(schemaDir, /' \
        "${tmp}" \
    | awk '
        # run() ends at the first top-level closing brace after its opener;
        # upstream main() ends with an os.Exit(1) guard, so a return 0 is
        # needed for the success path.
        /^func run\(args \[\]string\) int \{$/ { inrun = 1 }
        inrun && /^}$/ { print "\treturn 0"; inrun = 0 }
        { print }
    '
} > "${TARGET}"

test -z "$(gofmt -l "${TARGET}")" || err "vendored ${TARGET} is not gofmt-clean"
log_success "Vendored ${UPSTREAM_PATH}@${COMMIT} into ${TARGET}"
log_info "vendored sha256 $(shasum -a 256 "${TARGET}" | cut -d' ' -f1); update vendoredDigest in ${PROVENANCE} if it changed"
