#
# Refresh the per-arch SHA256 checksums in .settings.yaml after a chainsaw
# version bump. Invoked by Renovate via postUpgradeTasks (.github/renovate.json5)
# whenever testing_tools.chainsaw is updated.
#
# Usage: tools/update-chainsaw-checksums <chainsaw-version>
#   e.g. tools/update-chainsaw-checksums v0.2.15
#
# Idempotent: re-running with the currently-pinned version produces no diff.

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <chainsaw-version>" >&2
  exit 64
fi

VERSION="$1"
# Accept both "v0.2.15" and "0.2.15".
VERSION_NO_V="${VERSION#v}"
VERSION_WITH_V="v${VERSION_NO_V}"

SETTINGS_FILE=".settings.yaml"
if [[ ! -f "${SETTINGS_FILE}" ]]; then
  echo "ERROR: ${SETTINGS_FILE} not found (run from repo root)" >&2
  exit 1
fi

# Upstream release asset is named checksums.txt.
CHECKSUMS_URL="https://github.com/kyverno/chainsaw/releases/download/${VERSION_WITH_V}/checksums.txt"

TMPDIR=$(mktemp -d)
trap 'rm -rf "${TMPDIR}"' EXIT

echo "Fetching ${CHECKSUMS_URL}"
# Retry on transient failures (5xx, 408/429, connection refused, network
# blips). Up to 5 attempts; --retry-delay 0 means curl picks an exponential
# backoff. Total retry window capped at 180s.
if ! curl --fail --silent --show-error --location \
      --connect-timeout 10 --max-time 60 \
      --retry 5 --retry-delay 0 --retry-max-time 180 \
      --retry-connrefused \
      --output "${TMPDIR}/checksums.txt" \
      "${CHECKSUMS_URL}"; then
  echo "ERROR: failed to download ${CHECKSUMS_URL} after retries" >&2
  exit 1
fi

# Each line in the upstream file is "<sha256>  chainsaw_<os>_<arch>.tar.gz".
# Map (os, arch) → SHA256 for the four platforms .settings.yaml tracks.
extract_sha() {
  local os="$1" arch="$2"
  local pattern="chainsaw_${os}_${arch}\\.tar\\.gz"
  local line
  line=$(grep -E "  ${pattern}\$" "${TMPDIR}/checksums.txt" || true)
  if [[ -z "${line}" ]]; then
    echo "ERROR: no checksum entry matching ${pattern} in ${CHECKSUMS_URL}" >&2
    exit 1
  fi
  echo "${line%% *}"
}

LINUX_AMD64=$(extract_sha linux amd64)
LINUX_ARM64=$(extract_sha linux arm64)
DARWIN_AMD64=$(extract_sha darwin amd64)
DARWIN_ARM64=$(extract_sha darwin arm64)

echo "  linux_amd64:  ${LINUX_AMD64}"
echo "  linux_arm64:  ${LINUX_ARM64}"
echo "  darwin_amd64: ${DARWIN_AMD64}"
echo "  darwin_arm64: ${DARWIN_ARM64}"

# Rewrite the four checksum lines in-place inside the chainsaw_checksums:
# block via awk, matching update-helmfile-checksums and
# update-helm-diff-checksums.
#
# This previously used a sed anchored on the arch key alone, with no block
# scoping. Four blocks in .settings.yaml -- helm_diff_checksums,
# helmfile_checksums, chainsaw_checksums, mkcert_checksums -- carry the same
# sub-keys at the same indent, so a single `replace_sha linux_amd64` rewrote
# all four, and the post-check passed because it only asserted the new value
# existed *somewhere*. A chainsaw bump would have silently written chainsaw's
# digests into the other three (#2658).
#
# mikefarah/yq would also work but drops blank lines between top-level
# mappings and would reformat the whole file on every Renovate PR -- see the
# failure-modes note in .github/RENOVATE.md.
# The replacement file must live on the same filesystem as ${SETTINGS_FILE} so
# the final mv is an atomic rename. ${TMPDIR} is frequently a separate
# filesystem, where mv degrades to copy-then-delete and a failure mid-copy
# would leave .settings.yaml truncated. Same reasoning as
# update-helm-diff-checksums.
NEW_FILE="$(mktemp "${SETTINGS_FILE}.new.XXXXXX")"
trap 'rm -rf "${TMPDIR}" "${NEW_FILE}"' EXIT
# mktemp creates 0600; seed from the target so the rename preserves its mode.
cp -p "${SETTINGS_FILE}" "${NEW_FILE}"

awk -v amd64="${LINUX_AMD64}" -v arm64="${LINUX_ARM64}" \
    -v damd64="${DARWIN_AMD64}" -v darm64="${DARWIN_ARM64}" '
    BEGIN { in_block = 0 }
    # Enter chainsaw_checksums block.
    /^  chainsaw_checksums:[[:space:]]*$/ { in_block = 1; print; next }
    # Leave the block on any other 2-space key, and on any column-0 line. The
    # second rule is what makes this safe when chainsaw_checksums is the last
    # key of its section: without it in_block stays set to EOF and the next
    # 4-space digest line anywhere in the file -- in another section entirely --
    # gets rewritten, which is the cross-block clobber this script exists to
    # stop.
    in_block && /^[^ ]/ { in_block = 0 }
    in_block && /^  [a-zA-Z_]/ && !/^    / { in_block = 0 }
    in_block && /^    linux_amd64:[[:space:]]*'\''[0-9a-f]{64}'\''/  { print "    linux_amd64: \x27" amd64 "\x27"; next }
    in_block && /^    linux_arm64:[[:space:]]*'\''[0-9a-f]{64}'\''/  { print "    linux_arm64: \x27" arm64 "\x27"; next }
    in_block && /^    darwin_amd64:[[:space:]]*'\''[0-9a-f]{64}'\''/ { print "    darwin_amd64: \x27" damd64 "\x27"; next }
    in_block && /^    darwin_arm64:[[:space:]]*'\''[0-9a-f]{64}'\''/ { print "    darwin_arm64: \x27" darm64 "\x27"; next }
    { print }
  ' "${SETTINGS_FILE}" > "${NEW_FILE}"

# Verify the new value landed inside chainsaw_checksums specifically. The old
# post-check asked only whether the value existed anywhere in the file, which
# is what let the cross-block clobber pass silently.
verify_block() {
  local key="$1" sha="$2"
  if ! awk -v key="$key" -v sha="$sha" '
        /^  chainsaw_checksums:[[:space:]]*$/ { in_block = 1; next }
        in_block && /^[^ ]/ { in_block = 0 }
        in_block && /^  [a-zA-Z_]/ && !/^    / { in_block = 0 }
        in_block && $0 ~ "^    " key ":[[:space:]]*'\''" sha "'\''$" { found = 1 }
        END { exit !found }
      ' "${NEW_FILE}"; then
    echo "ERROR: verify_block: ${key} did not update to '${sha}' under chainsaw_checksums" >&2
    exit 1
  fi
}
verify_block linux_amd64  "${LINUX_AMD64}"
verify_block linux_arm64  "${LINUX_ARM64}"
verify_block darwin_amd64 "${DARWIN_AMD64}"
verify_block darwin_arm64 "${DARWIN_ARM64}"

mv "${NEW_FILE}" "${SETTINGS_FILE}"

echo "Updated ${SETTINGS_FILE} for chainsaw ${VERSION_WITH_V}"
