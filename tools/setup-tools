# AICR Development Environment Setup
#
# This script installs all required dependencies for development
# on Linux (x86_64/arm64) and macOS (amd64/arm64).
#
# Usage:
#   ./tools/setup-tools                    # Interactive mode
#   ./tools/setup-tools --auto             # Non-interactive mode
#   ./tools/setup-tools --skip-go          # Skip Go installation check
#   ./tools/setup-tools --skip-docker      # Skip Docker check
#   ./tools/setup-tools --skip-tools       # Skip development tools installation
#   ./tools/setup-tools --help             # Show help

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/common
. "${DIR}/common"
VERSIONS_FILE="${REPO_ROOT}/.settings.yaml"

# Configuration
AUTO_MODE=${AUTO_MODE:-false}
SKIP_GO=false
SKIP_DOCKER=false
SKIP_TOOLS=false
UPGRADE=false

# Detect OS and architecture
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Map architecture names for different tools
case "${ARCH}" in
    x86_64)
        GO_ARCH="amd64"
        ;;
    aarch64|arm64)
        GO_ARCH="arm64"
        ARCH="arm64"  # Normalize to arm64
        ;;
    *) echo -e "${RED}❌ Unsupported architecture: ${ARCH}${NC}" && exit 1 ;;
esac

# Verify URL accessibility before downloading
verify_download_url() {
    local url="$1"
    local description="$2"

    log_debug "Attempting to verify: $description"
    log_debug "URL: $url"

    local http_code
    http_code=$(curl -f -s -I -L -w "%{http_code}" -o /dev/null "$url" 2>/dev/null)
    local curl_exit_code=$?

    if [[ $curl_exit_code -ne 0 || "$http_code" != "200" ]]; then
        log_error "Failed to access URL for $description"
        log_error "URL: $url"
        log_error "HTTP status code: ${http_code:-unknown}"

        if [[ "$http_code" == "404" ]]; then
            log_error "File not found (404). The version or architecture might not be available."
        elif [[ "$http_code" == "403" ]]; then
            log_error "Access forbidden (403). This might be a rate limit issue."
        elif [[ $curl_exit_code -eq 6 ]]; then
            log_error "Could not resolve host. Check your internet connection."
        fi

        return 1
    fi

    log_debug "URL verified successfully for $description (HTTP $http_code)"
    return 0
}

# verify_digest compares a downloaded file against its expected digest and exits
# on anything short of a match. Every binary install goes through it, so an empty
# or unrecognized expectation is a failed check rather than a skipped one: it
# means the caller's checksum lookup came back empty, and installing anyway is
# the outcome this function exists to prevent.
verify_digest() {
    local file_path="$1"
    local algo="$2"
    local expected="$3"

    if [[ -z "$expected" ]]; then
        log_error "No expected ${algo} digest for $file_path; refusing to install an unverified binary."
        exit 1
    fi

    local bits
    case "$algo" in
        sha256) bits=256 ;;
        sha512) bits=512 ;;
        *)
            log_error "Unsupported digest algorithm '$algo' for $file_path."
            exit 1
            ;;
    esac

    # Accept either tool: shasum is the perl one macOS ships, <algo>sum is
    # coreutils on Linux.
    local actual
    if command_exists shasum; then
        actual=$(shasum -a "$bits" "$file_path" | awk '{print $1}')
    elif command_exists "${algo}sum"; then
        actual=$("${algo}sum" "$file_path" | awk '{print $1}')
    else
        log_error "Neither shasum nor ${algo}sum is available; cannot verify $file_path."
        log_error "Refusing to install an unverified binary. Install coreutils (or perl's shasum) and retry."
        exit 1
    fi

    if [[ "$actual" != "$expected" ]]; then
        log_error "Checksum mismatch for $file_path"
        log_error "Expected ${algo}: $expected"
        log_error "Actual ${algo}:   $actual"
        exit 1
    fi
}

# verify_sha256 used to return 0 for an empty or "SKIP" expectation, which let a
# failed checksum lookup install an unverified binary. It now fails closed on
# both, like every other outcome short of a match.
verify_sha256() {
    verify_digest "$1" sha256 "$2"
}

# Exit status the install subshell uses for an unreachable asset -- the one
# failure install_release_binary reports rather than aborts on.
RELEASE_ASSET_UNREACHABLE=3

# manifest_digest <checksums-file> <asset> prints the SHA-256 digest a combined
# checksums file records for <asset>, or nothing. It reads two shapes: GNU
# (`<digest>  <file>`, or `<digest> *<file>` in binary mode) and BSD
# (`SHA256 (<file>) = <digest>`, which yq publishes). The name is matched
# exactly, so `<asset>.sig` or a longer name that merely starts with it cannot
# supply the digest.
manifest_digest() {
    awk -v a="$2" '
        $2 == a || $2 == "*" a                         { print $1; exit }
        $1 == "SHA256" && $2 == "(" a ")" && $3 == "=" { print $4; exit }
    ' "$1"
}

# settings_yq_version <settings-file> prints the version pinned at
# .testing_tools.yq, or nothing. It reads the file without yq, because yq is
# what it is about to install, so it handles only that one key.
# tools/setup-tools_test.sh holds it to agreeing with yq on the real file.
settings_yq_version() {
    awk '
        /^testing_tools:/  { in_section = 1; next }
        /^[^[:space:]#]/   { in_section = 0 }
        in_section && /^  yq:/ {
            sub(/^  yq:[[:space:]]*/, "")
            sub(/[[:space:]]*(#.*)?$/, "")
            gsub(/["\047]/, "")
            print
            exit
        }
    ' "$1"
}

# release_sidecar_spec <sidecar:algo[:suffix]> prints "<algo> <suffix>". The
# suffix defaults per algorithm but cannot always be derived from it: dl.k8s.io
# publishes kubectl's SHA-256 as `.sha256`, not `.sha256sum`.
release_sidecar_spec() {
    local spec="${1#sidecar:}"
    local algo="${spec%%:*}" suffix=""
    if [[ "$spec" == *:* ]]; then
        suffix="${spec#*:}"
    fi
    case "$algo" in
        sha256) suffix="${suffix:-.sha256sum}" ;;
        sha512) suffix="${suffix:-.sha512}" ;;
        *)
            log_error "Unsupported sidecar digest algorithm '$algo'"
            return 1
            ;;
    esac
    echo "$algo $suffix"
}

# install_release_binary <asset-url> <checksum-source> <binary> <description> [archive-member]
#
# Downloads a release asset, verifies it, and installs <binary> into
# /usr/local/bin. It cannot run without a checksum source, which is what makes
# verification impossible to skip: every binary install goes through here, and
# tools/setup-tools_test.sh fails if one does not.
#
# <checksum-source> names where the expected digest comes from, never the digest:
#   manifest:<url>              a combined checksums file, looked up by the asset's name
#   sidecar:<algo>[:<suffix>]   <asset-url><suffix>; see release_sidecar_spec
#   pinned:<digest>             a sha256 committed in this repo
#
# [archive-member] is the binary's path inside a .tar.gz, when it is not
# <binary> at the archive root. It may be a glob. Any other asset is installed
# as the binary itself.
#
# An unreachable asset returns 1 so the caller can report it, as every install
# block did before this helper. Anything else -- a failed download, a missing or
# mismatched digest, a member not in the archive -- exits, because installing
# an unverified binary is worse than not installing it.
#
# The work runs in a subshell so its EXIT trap can clean the temp dir without
# replacing a trap of the caller's. It checks every step explicitly rather than
# relying on `set -e`, which bash suspends for a function called under `if`
# or `||` -- the way every caller calls this one.
install_release_binary() {
    local rc=0
    (
        url="$1" source="$2" binary="$3" description="$4" member="${5:-$3}"

        verify_download_url "$url" "$description" || exit "$RELEASE_ASSET_UNREACHABLE"

        tmp=$(mktemp -d) || exit 1
        trap 'rm -rf "$tmp"' EXIT

        asset="${url##*/}"
        if ! curl -fsSL -o "${tmp}/${asset}" "$url"; then
            log_error "Failed to download $description from $url"
            exit 1
        fi

        algo=sha256
        case "$source" in
            manifest:*)
                if ! curl -fsSL -o "${tmp}/checksums" "${source#manifest:}"; then
                    log_error "Failed to download the checksums file for $description"
                    exit 1
                fi
                expected=$(manifest_digest "${tmp}/checksums" "$asset")
                ;;
            sidecar:*)
                spec=$(release_sidecar_spec "$source") || exit 1
                algo="${spec%% *}"
                expected=$(curl -fsSL "${url}${spec#* }" | awk '{print $1}') || expected=""
                ;;
            pinned:*)
                expected="${source#pinned:}"
                ;;
            *)
                log_error "Unknown checksum source '$source' for $description"
                exit 1
                ;;
        esac
        # Exits on an empty or mismatched digest; see verify_digest.
        verify_digest "${tmp}/${asset}" "$algo" "$expected"

        src="${tmp}/${asset}"
        case "$asset" in
            *.tar.gz|*.tgz)
                mkdir -p "${tmp}/extracted" || exit 1
                if ! tar -xzf "${tmp}/${asset}" -C "${tmp}/extracted"; then
                    log_error "Failed to extract $asset"
                    exit 1
                fi
                src=$(compgen -G "${tmp}/extracted/${member}" | head -1)
                if [[ -z "$src" ]]; then
                    log_error "$member not found in $asset"
                    exit 1
                fi
                ;;
        esac

        sudo install -m 0755 "$src" "/usr/local/bin/${binary}" || exit 1
    ) || rc=$?

    case "$rc" in
        0) return 0 ;;
        "$RELEASE_ASSET_UNREACHABLE") return 1 ;;
        *) exit "$rc" ;;
    esac
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Where `go install` would have placed a binary, so a tool built with `go build`
# lands on PATH in the same place and command_exists keeps finding it.
go_bin_dir() {
    local dir
    dir="$(go env GOBIN)"
    [[ -n "${dir}" ]] || dir="$(go env GOPATH)/bin"
    printf '%s' "${dir}"
}

# Build a tool from this module's own dependency graph instead of
# `go install pkg@version`. The module form resolves against go.mod and verifies
# against go.sum, so it never consults the checksum database; the pkg@version
# form resolves outside the module, where nothing is in go.sum, and so depended
# on sum.golang.org being reachable (#2667). Mirrors what CI does.
build_module_tool() {
    local name="$1" pkg="$2" bin_dir
    bin_dir="$(go_bin_dir)"
    mkdir -p "${bin_dir}"
    # Run from the repository root: `go build <pkg>` resolves the package
    # through the main module, so the working directory has to be inside it.
    #
    # GOFLAGS is pinned rather than inherited: an inherited -trimpath yields a
    # go-licenses with an empty GOROOT, which then reports the entire dependency
    # graph as standard library and writes nothing while exiting 0. See
    # tools/generate-notices_test.sh for the full failure mode.
    (cd "${REPO_ROOT}" && GOFLAGS=-mod=readonly go build -o "${bin_dir}/${name}" "${pkg}")
}

prompt_continue() {
    if [[ "${AUTO_MODE}" == "true" ]]; then
        return 0
    fi

    read -p "Continue? [Y/n] " -r
    REPLY=${REPLY:-Y}
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_warning "Skipped"
        return 1
    fi
    return 0
}

install_helm() {
    installed_helm_version=""
    if command_exists helm; then
        installed_helm_version=$(helm version --template '{{.Version}}' 2>/dev/null || true)
    fi
    if [[ "${installed_helm_version}" == "${HELM_VERSION}" && "${UPGRADE}" != "true" ]]; then
        log_success "Helm already installed: ${installed_helm_version}"
    else
        log_info "Installing Helm ${HELM_VERSION}..."
        if prompt_continue; then
            if [[ "${OS}" == "darwin" ]]; then
                # installed_helm_version only proves helm is on PATH, not that
                # Homebrew manages it; `brew upgrade` fails on a manually
                # installed binary because there's no Homebrew keg to upgrade.
                if brew list --versions helm >/dev/null 2>&1; then
                    brew upgrade helm
                else
                    brew install helm
                fi
            elif [[ "${OS}" == "linux" ]]; then
                if ! install_release_binary \
                    "https://get.helm.sh/helm-${HELM_VERSION}-linux-${GO_ARCH}.tar.gz" \
                    sidecar:sha256 helm "helm ${HELM_VERSION} for Linux ${GO_ARCH}" \
                    "linux-${GO_ARCH}/helm"; then
                    log_error "Failed to install helm. Please install manually."
                fi
            fi
            installed_helm_version=$(helm version --template '{{.Version}}' 2>/dev/null || echo "unknown")
            if [[ "${installed_helm_version}" == "${HELM_VERSION}" ]]; then
                log_success "Helm installed: ${installed_helm_version}"
            elif [[ "${OS}" == "darwin" ]]; then
                log_error "Helm ${installed_helm_version} installed, but ${HELM_VERSION} is pinned in .settings.yaml. Homebrew only ships the current stable release; install ${HELM_VERSION} manually from https://github.com/helm/helm/releases if it differs."
                return 1
            else
                log_error "Helm ${installed_helm_version} installed, but ${HELM_VERSION} is pinned in .settings.yaml. Install ${HELM_VERSION} manually from https://github.com/helm/helm/releases."
                return 1
            fi
        fi
    fi
}

show_help() {
    cat << EOF
AICR Development Environment Setup

Usage: $0 [OPTIONS]

OPTIONS:
    --auto              Non-interactive mode (auto-yes to all prompts)
    --upgrade           Reinstall/upgrade tools to versions in .settings.yaml (default: skip if already installed)
    --skip-go           Skip Go installation check
    --skip-docker       Skip Docker installation check
    --skip-tools        Skip development tools installation
    --help              Show this help message

ENVIRONMENT VARIABLES:
    AUTO_MODE=true      Same as --auto flag (non-interactive mode)
    DEBUG=true          Enable debug output (shows URLs, architecture mappings)

EXAMPLES:
    # Interactive mode
    $0

    # Automated CI setup
    $0 --auto

    # Upgrade all tools to .settings.yaml (e.g. make tools-update)
    $0 --upgrade --auto

    # Install only tools (Go already installed)
    $0 --skip-go --skip-docker

    # Enable debug output to troubleshoot download issues
    DEBUG=true $0

EOF
}

# Whether a module-built tool's installed version already matches its go.mod
# pin. An unreadable binary reports an empty current version and must rebuild
# rather than be treated as a match. A function so setup-tools_test.sh can
# exercise the retain/replace decision, which is otherwise top-level code that
# only runs during a real install.
module_tool_up_to_date() {
    local current="$1"
    local required="$2"

    [[ -n "${current}" && -n "${required}" && "${current}" == "${required}" ]]
}

# Test hook: lets setup-tools_test.sh source this file to reach the function
# definitions above (command_exists, prompt_continue, install_helm, ...) and
# call them directly with mocked commands, without running the argument
# parser or the rest of the script, which would try to install every tool
# pinned in .settings.yaml.
if [[ "${SETUP_TOOLS_SOURCE_ONLY:-false}" == "true" ]]; then
    return 0
fi

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --auto)
            AUTO_MODE=true
            shift
            ;;
        --skip-go)
            SKIP_GO=true
            shift
            ;;
        --skip-docker)
            SKIP_DOCKER=true
            shift
            ;;
        --skip-tools)
            SKIP_TOOLS=true
            shift
            ;;
        --upgrade)
            UPGRADE=true
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            log_error "Unknown option: $1"
            show_help
            exit 1
            ;;
    esac
done

# Banner
echo ""
echo "╔════════════════════════════════════════════════════════╗"
echo "║   AICR Development Environment Setup                  ║"
echo "╚════════════════════════════════════════════════════════╝"
echo ""
log_info "Platform: ${OS}-${GO_ARCH}"
log_debug "Architecture: ${ARCH} -> GO_ARCH=${GO_ARCH}"
echo ""

# Check if .settings.yaml exists
if [[ ! -f "${VERSIONS_FILE}" ]]; then
    log_error "Version file not found: ${VERSIONS_FILE}"
    log_error "Please run this script from the repository root or ensure .settings.yaml exists"
    exit 1
fi

# is_mikefarah_yq returns 0 if the installed yq is mikefarah/yq (Go-based).
# Python-based yq (pip) wraps jq and outputs JSON-quoted strings, breaking
# version parsing throughout this script and the broader toolchain.
is_mikefarah_yq() {
    yq --version 2>/dev/null | grep -q "mikefarah/yq"
}

# Fail fast if the wrong yq variant is installed.
if command_exists yq && ! is_mikefarah_yq; then
    log_error "Found Python-based yq at $(which yq)."
    log_error "This project requires mikefarah/yq (Go-based)."
    log_error "Please remove it first:  pip uninstall yq  (or:  sudo apt remove yq)"
    log_error "Then re-run:  make tools-setup"
    exit 1
fi

# Install yq if not present or --upgrade (needed to parse .settings.yaml)
if ! command_exists yq || [[ "${UPGRADE}" == "true" ]]; then
    if command_exists yq && [[ "${UPGRADE}" == "true" ]]; then
        log_info "Upgrading yq (YAML processor)..."
    else
        log_info "Installing yq (YAML processor)..."
    fi

    if [[ "${OS}" == "darwin" ]]; then
        if command_exists brew; then
            brew install yq
        else
            log_error "Homebrew not found. Please install Homebrew first: https://brew.sh"
            exit 1
        fi
    elif [[ "${OS}" == "linux" ]]; then
        # install-e2e-tools checks the installed yq against this pin before it
        # saves the tool cache.
        YQ_VERSION=$(settings_yq_version "${VERSIONS_FILE}")
        if [[ -z "${YQ_VERSION}" ]]; then
            log_error "No yq version pinned under testing_tools in .settings.yaml"
            exit 1
        fi
        YQ_RELEASE="https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}"
        # yq's `checksums` puts the file name first, then one digest per
        # algorithm in an order kept in a separate file; `checksums-bsd` labels
        # each digest with its algorithm.
        if ! install_release_binary "${YQ_RELEASE}/yq_linux_${GO_ARCH}" \
            "manifest:${YQ_RELEASE}/checksums-bsd" \
            yq "yq ${YQ_VERSION} for Linux ${GO_ARCH}"; then
            log_error "Failed to install yq. Please install manually."
            exit 1
        fi
    fi

    log_success "yq installed"
else
    log_success "yq already installed: $(yq --version)"
fi

# Load versions from .settings.yaml
log_info "Loading versions from .settings.yaml..."
cd "${REPO_ROOT}"

GO_VERSION=$(yq '.languages.go' .settings.yaml)
GOLANGCI_LINT_VERSION=$(yq '.linting.golangci_lint' .settings.yaml)
# apidiff and go-licenses are built from this module (#2667), so go.mod's
# require line is their only pin -- .settings.yaml does not carry one. Fail
# closed: yq would have returned the string "null" for the removed key, which
# never equals an installed version and so rebuilds on every run.
if ! APIDIFF_VERSION=$(go_mod_required_version golang.org/x/exp go.mod); then
    log_error "No golang.org/x/exp require line in go.mod; cannot resolve the apidiff version."
    exit 1
fi
OASDIFF_VERSION=$(yq '.linting.oasdiff' .settings.yaml)
YAMLLINT_VERSION=$(yq '.linting.yamllint' .settings.yaml)
ADDLICENSE_VERSION=$(yq '.linting.addlicense' .settings.yaml)
# Committed linux/amd64 digest, used in preference to the release's own
# checksums.txt when this host matches it. A manifest served beside the archive
# comes from the same release, so it detects corruption in transit but not a
# compromise of the release; the committed value was reviewed at a known SHA.
# Using it here also makes a local run a second check on the pin CI depends on,
# which nothing outside CI otherwise exercises.
ADDLICENSE_SHA256_LINUX_AMD64=$(yq '.linting.addlicense_sha256_linux_amd64' .settings.yaml)
if ! GO_LICENSES_VERSION=$(go_mod_required_version github.com/google/go-licenses/v2 go.mod); then
    log_error "No github.com/google/go-licenses/v2 require line in go.mod; cannot resolve the go-licenses version."
    exit 1
fi
GRYPE_VERSION=$(yq '.security_tools.grype' .settings.yaml)
COSIGN_VERSION=$(yq '.security_tools.cosign' .settings.yaml)
SYFT_VERSION=$(yq '.security_tools.syft' .settings.yaml)
ORAS_VERSION=$(yq '.security_tools.oras' .settings.yaml)
KIND_VERSION=$(yq '.testing_tools.kind' .settings.yaml)
KUBECTL_VERSION=$(yq '.testing_tools.kubectl' .settings.yaml)
CTLPTL_VERSION=$(yq '.testing_tools.ctlptl' .settings.yaml)
TILT_VERSION=$(yq '.testing_tools.tilt' .settings.yaml)
HELM_VERSION=$(yq '.testing_tools.helm' .settings.yaml)
HELMFILE_VERSION=$(yq '.testing_tools.helmfile' .settings.yaml)
CHAINSAW_VERSION=$(yq '.testing_tools.chainsaw' .settings.yaml)
MKCERT_VERSION=$(yq '.testing_tools.mkcert' .settings.yaml)
AWSCLI_VERSION=$(yq '.testing_tools.awscli' .settings.yaml)
HAULER_VERSION=$(yq '.testing_tools.hauler' .settings.yaml)
ZARF_VERSION=$(yq '.testing_tools.zarf' .settings.yaml)
FLUX_VERSION=$(yq '.testing_tools.flux_version' .settings.yaml)
KO_VERSION=$(yq '.build_tools.ko' .settings.yaml)
CRANE_VERSION=$(yq '.build_tools.crane' .settings.yaml)
GORELEASER_VERSION=$(yq '.build_tools.goreleaser' .settings.yaml)
GIT_CLIFF_VERSION=$(yq '.build_tools.git_cliff' .settings.yaml)

echo ""
log_info "Target Versions:"
echo "  Go:              ${GO_VERSION}"
echo "  golangci-lint:   ${GOLANGCI_LINT_VERSION}"
echo "  apidiff:         ${APIDIFF_VERSION}"
echo "  oasdiff:         ${OASDIFF_VERSION}"
echo "  grype:           ${GRYPE_VERSION}"
echo "  cosign:          ${COSIGN_VERSION}"
echo "  syft:            ${SYFT_VERSION}"
echo "  kind:            ${KIND_VERSION}"
echo "  kubectl:         ${KUBECTL_VERSION}"
echo "  tilt:            ${TILT_VERSION}"
echo "  helm:            ${HELM_VERSION}"
echo "  helmfile:        ${HELMFILE_VERSION}"
echo "  chainsaw:        ${CHAINSAW_VERSION}"
echo "  mkcert:          ${MKCERT_VERSION}"
echo "  awscli:          ${AWSCLI_VERSION}"
echo "  hauler:          ${HAULER_VERSION}"
echo "  zarf:            ${ZARF_VERSION}"
echo "  flux:            ${FLUX_VERSION}"
echo "  goreleaser:      ${GORELEASER_VERSION}"
echo "  git-cliff:       ${GIT_CLIFF_VERSION}"
echo ""

# ============================================================================
# Go Installation Check
# ============================================================================
if [[ "${SKIP_GO}" == "false" ]]; then
    echo "════════════════════════════════════════════════════════"
    log_info "Go Installation"
    echo "════════════════════════════════════════════════════════"

    if command_exists go; then
        CURRENT_GO=$(go version | grep -o 'go[0-9]\+\.[0-9]\+\(\.[0-9]\+\)\?' | sed 's/go//' || echo "unknown")
        log_info "Current Go version: ${CURRENT_GO}"

        if [[ "${CURRENT_GO}" == "${GO_VERSION}"* ]]; then
            log_success "Go ${GO_VERSION} already installed"
        else
            log_warning "Go version mismatch (current: ${CURRENT_GO}, target: ${GO_VERSION})"
            log_info "Please install Go ${GO_VERSION} from https://go.dev/dl/"
        fi
    else
        log_warning "Go not found"
        log_info "Please install Go ${GO_VERSION} from https://go.dev/dl/"
    fi
    echo ""
fi

# ============================================================================
# Docker Check
# ============================================================================
if [[ "${SKIP_DOCKER}" == "false" ]]; then
    echo "════════════════════════════════════════════════════════"
    log_info "Docker Check"
    echo "════════════════════════════════════════════════════════"

    if command_exists docker; then
        if docker info >/dev/null 2>&1; then
            DOCKER_VERSION=$(docker version --format '{{.Server.Version}}')
            log_success "Docker is installed and running: ${DOCKER_VERSION}"
        else
            log_warning "Docker is installed but not running"
            log_info "Please start Docker Desktop or the Docker daemon"
        fi
    else
        log_warning "Docker not found"
        log_info "Please install Docker: https://docs.docker.com/get-docker/"
    fi
    echo ""
fi

# ============================================================================
# Development Tools Installation
# ============================================================================
if [[ "${SKIP_TOOLS}" == "false" ]]; then
    echo "════════════════════════════════════════════════════════"
    log_info "Development Tools Installation"
    echo "════════════════════════════════════════════════════════"

    GRYPE_INSTALL_SHA256=${GRYPE_INSTALL_SHA256:-"8646f06a90b10ca64992c1809b4aa00c44e30b4f551f63c309b0b0ab66873556"}
