                brew install git-cliff
                log_success "git-cliff installed"
            elif [[ "${OS}" == "linux" ]]; then
                GIT_CLIFF_ARCH="x86_64"
                if [[ "${GO_ARCH}" == "arm64" ]]; then
                    GIT_CLIFF_ARCH="aarch64"
                fi
                # git-cliff publishes a per-asset SHA-512 rather than a combined
                # checksums file, and nests the binary in a versioned directory.
                if install_release_binary \
                    "https://github.com/orhun/git-cliff/releases/download/v${GIT_CLIFF_VERSION}/git-cliff-${GIT_CLIFF_VERSION}-${GIT_CLIFF_ARCH}-unknown-linux-gnu.tar.gz" \
                    sidecar:sha512 git-cliff "git-cliff ${GIT_CLIFF_VERSION} for Linux ${GO_ARCH}" \
                    "git-cliff-${GIT_CLIFF_VERSION}*/git-cliff"; then
                    log_success "git-cliff installed"
                else
                    log_error "Failed to install git-cliff. Please install manually."
                fi
            fi
        fi
    fi

    echo ""
fi

# ============================================================================
# Go Development Tools
# ============================================================================
if [[ "${SKIP_TOOLS}" == "false" ]] && command_exists go; then
    echo "════════════════════════════════════════════════════════"
    log_info "Go Development Tools"
    echo "════════════════════════════════════════════════════════"

    # golangci-lint
    if command_exists golangci-lint && [[ "${UPGRADE}" != "true" ]]; then
        CURRENT_LINT=$(golangci-lint version 2>/dev/null | awk '{print $4}' || echo "unknown")
        log_success "golangci-lint already installed: ${CURRENT_LINT}"
    else
        log_info "Installing golangci-lint ${GOLANGCI_LINT_VERSION}..."
        if prompt_continue; then
            GOLANGCI_SCRIPT_URL="https://raw.githubusercontent.com/golangci/golangci-lint/${GOLANGCI_LINT_VERSION}/install.sh"
            GOLANGCI_TMP=$(mktemp)
            curl -fsSL "$GOLANGCI_SCRIPT_URL" -o "$GOLANGCI_TMP"
            verify_sha256 "$GOLANGCI_TMP" "${GOLANGCI_LINT_INSTALL_SHA256}"
            sh "$GOLANGCI_TMP" -b "$(go env GOPATH)/bin" "${GOLANGCI_LINT_VERSION}"
            rm -f "$GOLANGCI_TMP"
            log_success "golangci-lint installed"
        fi
    fi

    # apidiff
    APIDIFF_CURRENT_VERSION=""
    if command_exists apidiff && [[ "${UPGRADE}" != "true" ]]; then
        APIDIFF_PATH=$(command -v apidiff)
        APIDIFF_CURRENT_VERSION=$(go_binary_module_version "${APIDIFF_PATH}" golang.org/x/exp || true)
    fi

    if [[ "${UPGRADE}" != "true" ]] && module_tool_up_to_date "${APIDIFF_CURRENT_VERSION}" "${APIDIFF_VERSION}"; then
        log_success "apidiff ${APIDIFF_VERSION} already installed"
    else
        if command_exists apidiff && [[ "${UPGRADE}" != "true" ]]; then
            if [[ -n "${APIDIFF_CURRENT_VERSION}" ]]; then
                log_warning "apidiff version mismatch at ${APIDIFF_PATH} (installed: ${APIDIFF_CURRENT_VERSION}, required: ${APIDIFF_VERSION}); reinstalling pinned version"
            else
                log_warning "Unable to verify apidiff module version at ${APIDIFF_PATH}; reinstalling pinned version ${APIDIFF_VERSION}"
            fi
        fi
        log_info "Installing apidiff ${APIDIFF_VERSION}..."
        if prompt_continue; then
            build_module_tool apidiff golang.org/x/exp/cmd/apidiff
            log_success "apidiff ${APIDIFF_VERSION} installed"
        fi
    fi

    # oasdiff. Existence is not enough: tools/check-tools requires an exact
    # module-version match, so an older binary already on PATH would leave
    # setup reporting success while the gate runs on a different version.
    oasdiff_current=""
    if command_exists oasdiff; then
        oasdiff_current="$(go version -m "$(command -v oasdiff)" 2>/dev/null |
            awk '$1 == "mod" && $2 == "github.com/oasdiff/oasdiff" {print $3; exit}')"
    fi
    if [[ "${oasdiff_current}" == "${OASDIFF_VERSION}" && "${UPGRADE}" != "true" ]]; then
        log_success "oasdiff ${OASDIFF_VERSION} already installed"
    else
        if [[ -n "${oasdiff_current}" && "${oasdiff_current}" != "${OASDIFF_VERSION}" ]]; then
            log_warning "oasdiff ${oasdiff_current} found; replacing with the pinned ${OASDIFF_VERSION}"
        fi
        log_info "Installing oasdiff ${OASDIFF_VERSION}..."
        if prompt_continue; then
            # Binary release rather than `go install`; see the ctlptl block
            # above for why (#2664).
            OASDIFF_VERSION_NUM="${OASDIFF_VERSION#v}"
            OASDIFF_TAR="oasdiff_${OASDIFF_VERSION_NUM}_linux_${GO_ARCH}.tar.gz"
            OASDIFF_BASE="https://github.com/oasdiff/oasdiff/releases/download/v${OASDIFF_VERSION_NUM}"
            if install_release_binary "${OASDIFF_BASE}/${OASDIFF_TAR}" \
                "manifest:${OASDIFF_BASE}/checksums.txt" \
                oasdiff "oasdiff ${OASDIFF_VERSION} for Linux ${GO_ARCH}"; then
                log_success "oasdiff ${OASDIFF_VERSION} installed"
            else
                log_error "Failed to install oasdiff. Please install manually."
            fi
        fi
    fi

    # addlicense. Existence alone is not enough, for the same reason spelled out
    # on oasdiff above and one more specific to this block: #2667 moved the
    # install from `go install` (which wrote to GOPATH/bin) to a release binary
    # in /usr/local/bin. Anyone who ran this script before that still has a
    # GOPATH/bin copy, and it shadows the new one wherever GOPATH/bin comes
    # first on PATH. A bare existence check would report success while
    # `addlicense` still resolved to the old binary, and tools/check-tools would
    # then fail strict_exact with no hint that a second copy exists.
    addlicense_current=""
    if command_exists addlicense; then
        addlicense_current="$(go version -m "$(command -v addlicense)" 2>/dev/null |
            awk '$1 == "mod" && $2 == "github.com/google/addlicense" {print $3; exit}')"
    fi
    if [[ "${addlicense_current}" == "${ADDLICENSE_VERSION}" && "${UPGRADE}" != "true" ]]; then
        log_success "addlicense ${ADDLICENSE_VERSION} already installed"
    else
        if [[ -n "${addlicense_current}" && "${addlicense_current}" != "${ADDLICENSE_VERSION}" ]]; then
            log_warning "addlicense ${addlicense_current} found at $(command -v addlicense); installing the pinned ${ADDLICENSE_VERSION}"
            if [[ "$(command -v addlicense)" != "/usr/local/bin/addlicense" ]]; then
                log_warning "It will be installed to /usr/local/bin; remove $(command -v addlicense) if it keeps taking precedence on PATH"
            fi
        fi
        log_info "Installing addlicense ${ADDLICENSE_VERSION}..."
        if prompt_continue; then
            # Binary release rather than `go install`, matching what CI does so
            # the two agree (#2667); see the oasdiff block above for the same
            # move. The asset names use uname's own spellings, so ARCH is used
            # here rather than GO_ARCH.
            case "${OS}" in
                linux)  ADDLICENSE_OS="Linux" ;;
                darwin) ADDLICENSE_OS="macOS" ;;
                *)
                    log_error "No addlicense release build for ${OS}; install it manually."
                    exit 1
                    ;;
            esac
            ADDLICENSE_TAR="addlicense_${ADDLICENSE_VERSION}_${ADDLICENSE_OS}_${ARCH}.tar.gz"
            ADDLICENSE_BASE="https://github.com/google/addlicense/releases/download/${ADDLICENSE_VERSION}"
            # Prefer the committed pin on the one platform it covers; fall back to
            # the release manifest elsewhere. .settings.yaml carries linux/amd64
            # only because that is what the CI action needs.
            if [[ "${OS}" == "linux" && "${GO_ARCH}" == "amd64" &&
                  "${ADDLICENSE_SHA256_LINUX_AMD64}" =~ ^[0-9a-f]{64}$ ]]; then
                ADDLICENSE_CHECKSUM="pinned:${ADDLICENSE_SHA256_LINUX_AMD64}"
            else
                ADDLICENSE_CHECKSUM="manifest:${ADDLICENSE_BASE}/checksums.txt"
            fi
            if install_release_binary "${ADDLICENSE_BASE}/${ADDLICENSE_TAR}" "${ADDLICENSE_CHECKSUM}" \
                addlicense "addlicense ${ADDLICENSE_VERSION} for ${ADDLICENSE_OS} ${ARCH}"; then
                log_success "addlicense ${ADDLICENSE_VERSION} installed"
            else
                log_error "Failed to install addlicense. Please install manually."
            fi
        fi
    fi

    # go-licenses
    GO_LICENSES_CURRENT_VERSION=""
    if command_exists go-licenses && [[ "${UPGRADE}" != "true" ]]; then
        GO_LICENSES_PATH=$(command -v go-licenses)
        GO_LICENSES_CURRENT_VERSION=$(go_binary_module_version "${GO_LICENSES_PATH}" github.com/google/go-licenses/v2 || true)
    fi

    if [[ "${UPGRADE}" != "true" ]] && module_tool_up_to_date "${GO_LICENSES_CURRENT_VERSION}" "${GO_LICENSES_VERSION}"; then
        log_success "go-licenses ${GO_LICENSES_VERSION} already installed"
    else
        if command_exists go-licenses && [[ "${UPGRADE}" != "true" ]]; then
            if [[ -n "${GO_LICENSES_CURRENT_VERSION}" ]]; then
                log_warning "go-licenses version mismatch at ${GO_LICENSES_PATH} (installed: ${GO_LICENSES_CURRENT_VERSION}, required: ${GO_LICENSES_VERSION}); reinstalling pinned version"
            else
                log_warning "Unable to verify go-licenses module version at ${GO_LICENSES_PATH}; reinstalling pinned version ${GO_LICENSES_VERSION}"
            fi
        fi
        log_info "Installing go-licenses ${GO_LICENSES_VERSION}..."
        if prompt_continue; then
            build_module_tool go-licenses github.com/google/go-licenses/v2
            log_success "go-licenses ${GO_LICENSES_VERSION} installed"
        fi
    fi

    echo ""
fi

